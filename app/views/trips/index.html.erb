<div class="d-flex justify-content-between align-items-center custom-margin">
  <!-- Link per tornare alla home -->
  <div class="back-arrow">
      <a href="#" onclick="window.history.back(); return false;" title="Go back">
        &#8592; <!-- Codice della freccia (←) -->
      </a>
    </div>

  <!-- Titolo centrato -->
  <h1 class="text-center flex-grow-1">Trip List</h1>
</div>

<%= form_with url: trips_path, method: :get, class: "horizontal-form custom-margin" do %>
  <div class="form-group-checkbox">
    <!-- Checkbox for direct flights -->
    <input type="checkbox" id="direct_flights" name="direct" value="yes" <%= 'checked' if params[:direct] == 'yes' %>>
    <label for="direct_flights">Show only direct flights</label>
  </div>

  <div class="form-group-checkbox">
    <!-- Checkbox for flexible flights -->
    <input type="checkbox" id="flexible_flights" name="flexible" value="yes" <%= 'checked' if params[:flexible] == 'yes' %>>
    <label for="flexible_flights">Show only flexible flights</label>
  </div>

  <div class="form-group">
    <!-- Input field for budget -->
    <label for="budget">Budget (EUR):</label>
    <input type="number" id="budget" name="budget" value="<%= params[:budget] %>" placeholder="Enter your budget">
  </div>

  <div class="search-button">
    <input type="submit" value="Apply Filters">
  </div>
<% end %>
<% if @trips.any? %>
  <table class="flight-table">
    <thead>
        <tr>
        <th>Trip Type</th>
        <th>Departure Airport</th>
        <th>Arrival Airport</th>
        <!-- Modify the sorting links to include current filter parameters -->
        <th><%= link_to 'Departure Time', trips_path(sort: 'departure_time_outbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
        <th><%= link_to 'Arrival Time', trips_path(sort: 'arrival_time_outbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
        <th><%= link_to 'Duration', trips_path(sort: 'duration_outbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
        <th><%= link_to 'Total Price', trips_path(sort: 'total_price', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
        <th>Direct?</th>

        <% if @trips.first[:trip_type] == 'round_trip' %>
          <th>Return: Departure Airport</th>
          <th>Return: Arrival Airport</th>
          <th><%= link_to 'Return: Departure Time', trips_path(sort: 'departure_time_inbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
          <th><%= link_to 'Return: Arrival Time', trips_path(sort: 'arrival_time_inbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
          <th><%= link_to 'Return Duration', trips_path(sort: 'duration_inbound', direct: params[:direct], flexible: params[:flexible], budget: params[:budget]) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @trips.each do |trip| %>
        <tr>
          <td><%= trip[:trip_type] %></td>
          <td><%= trip[:departure_airport_outbound] %></td>
          <td><%= trip[:arrival_airport_outbound] %></td>
          <td><%= trip[:departure_time_outbound].strftime("%d-%m-%Y %H:%M") %></td>
          <td><%= trip[:arrival_time_outbound].strftime("%d-%m-%Y %H:%M") %></td>
          <td><%= trip[:duration_outbound] %> min</td>
          <td><%= trip[:total_price] %> EUR</td>
          <td><%= trip[:is_direct_outbound] ? "Yes" : "No" %></td>
          <% if trip[:trip_type] == 'round_trip' %>
            <td><%= trip[:departure_airport_inbound] %></td>
            <td><%= trip[:arrival_airport_inbound] %></td>
            <td><%= trip[:departure_time_inbound].strftime("%d-%m-%Y %H:%M") %></td>
            <td><%= trip[:arrival_time_inbound].strftime("%d-%m-%Y %H:%M") %></td>
            <td><%= trip[:duration_inbound] %> min</td>
            <td><%= trip[:is_direct_inbound] ? "Yes" : "No" %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No trips found.</p>
<% end %>

<!-- Search Form -->
<%= form_with url: search_trip_trips_path, method: :post, class: "horizontal-form custom-margin" do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <div class="form-group">
    <label for="departure_city">Departure city:</label>
    <div class="suggestion-form">
      <input type="text" id="departure_city" name="departure_city" required onkeyup="suggestCities(this.value, 'departure_suggestions', 'departure_city')">
      <ul id="departure_suggestions" class="suggestions"></ul>
    </div>
  </div>

  <div class="form-group">
    <label for="destination_city">Destination city:</label>
    <div class="suggestion-form">
      <input type="text" id="destination_city" name="destination_city" required onkeyup="suggestCities(this.value, 'destination_suggestions', 'destination_city')">
      <ul id="destination_suggestions" class="suggestions"></ul>
    </div>
  </div>

  <div class="form-group">
    <label for="departure_date">Departure date:</label>
    <input type="date" id="departure_date" name="departure_date" required>
  </div>

  <div class="form-group">
    <label for="number_of_people">Number of adults:</label>
    <input type="number" id="number_of_people" name="number_of_people" value="1" min="1" required>
  </div>

  <div class="form-group">
    <label for="number_of_children">Number of children:</label>
    <input type="number" id="number_of_children" name="number_of_children" value="0" min="0" required>
  </div>

  <div class="form-group">
    <label for="number_of_infants">Number of infants:</label>
    <input type="number" id="number_of_infants" name="number_of_infants" value="0" min="0" required>
  </div>

  <div class="form-group-checkbox">
    <label for="round_trip">Roundtrip</label>
    <input type="checkbox" id="round_trip" name="round_trip" value="yes" onclick="toggleReturnDate()">
  </div>

  <div class="form-group" id="return_date_div" style="display:none;">
    <label for="return_date">Return date:</label>
    <input type="date" id="return_date" name="return_date">
  </div>

  <div class="search-button">
    <input type="submit" value="Search">
  </div>
<% end %>

<script>
  function toggleReturnDate() {
    var roundTripCheckbox = document.getElementById('round_trip');
    var returnDateDiv = document.getElementById('return_date_div');
    if (roundTripCheckbox.checked) {
      returnDateDiv.style.display = 'block';
    } else {
      returnDateDiv.style.display = 'none';
    }
  }

  function suggestCities(query, suggestionListId, inputId) {
    if (query.length === 0) {
      document.getElementById(suggestionListId).innerHTML = "";
      return;
    }

    fetch(`/suggest_cities?query=${query}`)
      .then(response => response.json())
      .then(data => {
        const suggestionList = document.getElementById(suggestionListId);
        suggestionList.innerHTML = "";

        data.forEach(city => {
          const suggestionItem = document.createElement('li');
          suggestionItem.textContent = city.name;
          suggestionItem.onclick = () => {
            document.getElementById(inputId).value = city.name;
            suggestionList.innerHTML = "";
          };
          suggestionList.appendChild(suggestionItem);
        });
      });
  }
</script>


