<div id="<%= dom_id trip %>">
  <p>
    <strong>Trip type:</strong>
    <%= trip.trip_type %>
  </p>

  <p>
    <strong>Departure airport outbound:</strong>
    <%= trip.departure_airport_outbound %>
  </p>

  <p>
    <strong>Arrival airport outbound:</strong>
    <%= trip.arrival_airport_outbound %>
  </p>

  <p>
    <strong>Departure time outbound:</strong>
    <%= trip.departure_time_outbound %>
  </p>

  <p>
    <strong>Arrival time outbound:</strong>
    <%= trip.arrival_time_outbound %>
  </p>

  <p>
    <strong>Duration outbound:</strong>
    <%= trip.duration_outbound %>
  </p>

  <p>
    <strong>Stop count outbound:</strong>
    <%= trip.stop_count_outbound %>
  </p>

  <p>
    <strong>Is direct outbound:</strong>
    <%= trip.is_direct_outbound %>
  </p>

  <p>
    <strong>Departure airport inbound:</strong>
    <%= trip.departure_airport_inbound %>
  </p>

  <p>
    <strong>Arrival airport inbound:</strong>
    <%= trip.arrival_airport_inbound %>
  </p>

  <p>
    <strong>Departure time inbound:</strong>
    <%= trip.departure_time_inbound %>
  </p>

  <p>
    <strong>Arrival time inbound:</strong>
    <%= trip.arrival_time_inbound %>
  </p>

  <p>
    <strong>Duration inbound:</strong>
    <%= trip.duration_inbound %>
  </p>

  <p>
    <strong>Stop count inbound:</strong>
    <%= trip.stop_count_inbound %>
  </p>

  <p>
    <strong>Is direct inbound:</strong>
    <%= trip.is_direct_inbound %>
  </p>

  <p>
    <strong>Total price:</strong>
    <%= trip.total_price %>
  </p>

  <p>
    <strong>Total duration:</strong>
    <%= trip.total_duration %>
  </p>

  <p>
    <strong>Is change allowed:</strong>
    <%= trip.is_change_allowed %>
  </p>

  <p>
    <strong>Is cancellation allowed:</strong>
    <%= trip.is_cancellation_allowed %>
  </p>

</div>
