<!-- app/views/cities/index.html.erb -->
<p style="color: green"><%= notice %></p>
<div class="d-flex justify-content-between align-items-center custom-margin">
    <div class="back-arrow">
      <a href="#" onclick="window.history.back(); return false;" title="Go back">
        &#8592; <!-- Codice della freccia (←) -->
      </a>
    </div>

  <!-- Titolo centrato -->
  <h1 class="text-center flex-grow-1">Cities</h1>
</div>

<div id="cities" class="city-grid">
  <% @cities.each do |city| %>
    <div class="city-item">
     <%= render city %> 
     
      <p>
        <%= link_to "Show details", city %>
      </p>


      
    </div>
  <% end %>
</div>
