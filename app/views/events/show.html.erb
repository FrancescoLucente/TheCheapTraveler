<p style="color: green"><%= notice %></p>


<div class="d-flex justify-content-between align-items-center custom-margin">
    <div class="back-arrow">
      <a href="#" onclick="window.history.back(); return false;" title="Go back">
        &#8592; <!-- Codice della freccia (←) -->
      </a>
    </div>

  <!-- Titolo centrato -->
  <h1 class="text-center flex-grow-1"><%= @event.name %></h1>
</div>
<p>Start Date: <%= @event.event_date.strftime("%B %d, %Y %H:%M") %></p>
<p>Description: <%= @event.description %></p>
<p>Link: <%= link_to @event.link, @event.link %></p>